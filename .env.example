API_KEY=api-key-placeholder
MAX_CONTEXT_LEN=8192
LLM_TIMEOUT=300

# Speaker diarization only. Needs a real hf_ token AND accepting the license
# on pyannote/speaker-diarization-3.1. Leave unset to transcribe without
# speaker labels.
HF_TOKEN=hf_your_token_here

# Local (in-container Ollama via `docker compose --profile local up`):
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Remote only — Ollama reachable behind Cloudflare Access.
# Leave unset for local runs.
OLLAMA_CF_ACCESS_CLIENT_ID=ollama_client_id_here.access
OLLAMA_CF_ACCESS_CLIENT_SECRET=ollama_access_secret_here
