API_KEY=api-key-placeholder
MAX_CONTEXT_LEN=32768
LLM_TIMEOUT=300

OLLAMA_URL=http://ollama:11434

WHISPERX_URL=http://whisperx:8001

OLLAMA_MODEL=qwen3-vl:8b-instruct-q8_0
# qwen2.5vl:7b, qwen3.5:9b-q4_K_M, qwen3-vl:8b-instruct-q8_0, qwen3.5:9b

WHISPERX_API_KEY=whisperx-api-key-placeholder
WHISPERX_TIMEOUT=900

WHISPERX_MODEL=base
WHISPERX_LANGUAGE=en
WHISPERX_BATCH_SIZE=4
WHISPERX_DIARIZE=true

HF_TOKEN=hf_your_token_here

# Remote only — Ollama reachable behind Cloudflare Access.
# Leave unset for local runs.
WHISPERX_CF_ACCESS_CLIENT_ID=
WHISPERX_CF_ACCESS_CLIENT_SECRET=
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=